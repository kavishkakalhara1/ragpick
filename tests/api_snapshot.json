      "ingest": "(path: 'str | Path | None' = None, *, progress: 'ProgressCallback | None' = None, tenant: 'str | None' = None) -> 'dict[str, IngestStats]'",
      "query": "(question: 'str', *, groups: 'list[str] | None' = None, filters: 'dict[str, Any] | None' = None, top_k: 'int | None' = None, trace: 'bool | None' = None, tenant: 'str | None' = None) -> 'Answer'",

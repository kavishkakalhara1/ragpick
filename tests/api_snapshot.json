  "protocols": {
    "ChunkIndexer": {
      "index_chunks": "(chunks: 'list[Chunk]') -> 'None'"
    },
    "Chunker": {
      "split": "(docs: 'Iterable[Document]') -> 'list[Chunk]'"
    },
    "DocumentIndexer": {
      "index_documents": "(docs: 'list[Document]') -> 'None'"
    },
    "Embedder": {
      "embed": "(texts: 'list[str]') -> 'list[list[float]]'"
    },
    "Generator": {
      "generate": "(query: 'str', contexts: 'list[RetrievedChunk]') -> 'Answer'"
    },
    "KeywordIndex": {
      "add": "(chunks: 'list[Chunk]') -> 'None'",
      "load": "(path: 'str') -> 'None'",
      "persist": "(path: 'str') -> 'None'",
      "search": "(query: 'str', k: 'int', filters: 'Filters | None' = None) -> 'list[RetrievedChunk]'"
    },
    "Loader": {
      "load": "(path: 'str') -> 'Iterable[Document]'"
    },
    "Reranker": {
      "rerank": "(query: 'str', chunks: 'list[RetrievedChunk]', top_n: 'int') -> 'list[RetrievedChunk]'"
    },
    "Retriever": {
      "retrieve": "(query: 'str', k: 'int', filters: 'Filters | None' = None) -> 'list[RetrievedChunk]'"
    },
    "StreamingGenerator": {
      "stream": "(query: 'str', contexts: 'list[RetrievedChunk]') -> 'Iterator[str | Usage]'"
    },
    "TextCompleter": {
      "complete": "(system: 'str', user: 'str') -> 'Completion'"
    },
    "VectorStore": {
      "add": "(chunks: 'list[Chunk]') -> 'None'",
      "delete": "(doc_ids: 'list[str]') -> 'None'",
      "load": "(path: 'str') -> 'None'",
      "persist": "(path: 'str') -> 'None'",
      "search": "(vector: 'list[float]', k: 'int', filters: 'Filters | None' = None) -> 'list[RetrievedChunk]'"
    },
    "VisionCompleter": {
      "describe_image": "(image: 'bytes', mime: 'str', prompt: 'str') -> 'Completion'"
    }
  },

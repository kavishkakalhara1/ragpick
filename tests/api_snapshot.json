      "from_yaml": "(path: 'str | Path', overrides: 'Mapping[str, Any] | None' = None) -> 'Pipeline'",
      "ingest": "(path: 'str | Path | None' = None, *, batch_size: 'int' = 64, progress: 'ProgressCallback | None' = None, tenant: 'str | None' = None) -> 'IngestStats'",
      "load": "() -> 'None'",
      "persist": "() -> 'None'",
      "query": "(question: 'str', *, groups: 'list[str] | None' = None, filters: 'dict[str, Any] | None' = None, top_k: 'int | None' = None, trace: 'bool | None' = None, tenant: 'str | None' = None) -> 'Answer'",
      "ready": "() -> 'bool'",
      "record_feedback": "(answer: 'Answer', rating: 'str | int | float | bool', *, comment: 'str | None' = None, owner: 'str | None' = None, tenant: 'str | None' = None, groups: 'list[str] | None' = None) -> 'str'",
      "retrieve": "(question: 'str', *, groups: 'list[str] | None' = None, filters: 'dict[str, Any] | None' = None, top_k: 'int | None' = None, tenant: 'str | None' = None) -> 'list[RetrievedChunk]'",
      "stream": "(question: 'str', *, groups: 'list[str] | None' = None, filters: 'dict[str, Any] | None' = None, top_k: 'int | None' = None, tenant: 'str | None' = None) -> 'Iterator[StreamEvent]'"
    },
    "Router": {
      "chat": "(message: 'str', *, session_id: 'str | None' = None, owner: 'str | None' = None, groups: 'list[str] | None' = None, filters: 'dict[str, Any] | None' = None, top_k: 'int | None' = None, trace: 'bool | None' = None, tenant: 'str | None' = None) -> 'Answer'",
